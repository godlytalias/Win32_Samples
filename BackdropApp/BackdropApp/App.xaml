<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BackdropApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BackdropApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Grid" x:Key="WindowStyle">
                <Setter Property="TabFocusNavigation" Value="Cycle"/>
                <!-- Feature_OpenWithWASDKAcrylic: Update background value directly here during cleanup -->
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorBaseBrush}"/>
                <Setter Property="Width" Value="448"/>
                <Setter Property="Height" Value="Auto"/>
            </Style>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
