<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" 
                    name="PropertySheetApp"
                    type="win32" />
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <file name="PropertySheet.dll">
    <activatableClass name="PropertySheet.WinUIPropertySheet"
                      threadingModel="both"
                      xmlns="urn:schemas-microsoft-com:winrt.v1" />
    <activatableClass name="PropertySheet.PropSheetWindow"
                      threadingModel="both"
                      xmlns="urn:schemas-microsoft-com:winrt.v1" />
	  <activatableClass name="PropertySheet.WinUIPropSheetHeader"
						threadingModel="both"
						xmlns="urn:schemas-microsoft-com:winrt.v1" />
	  <activatableClass name="PropertySheet.IWinUIPropSheetPage"
						threadingModel="both"
						xmlns="urn:schemas-microsoft-com:winrt.v1" />
  </file>
	<file name="PropertySheetPage.dll">
		<activatableClass name="PropertySheetPage.GeneralPage"
						  threadingModel="both"
						  xmlns="urn:schemas-microsoft-com:winrt.v1" />
		<activatableClass name="PropertySheetPage.AdvancedPage"
						  threadingModel="both"
						  xmlns="urn:schemas-microsoft-com:winrt.v1" />
	</file>
</assembly>
